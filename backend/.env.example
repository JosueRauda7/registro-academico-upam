DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=upam_academico
DATABASE_USER=upam_app
# Usar las credenciales locales generadas en el .env de la raíz; no versionarlas.
DATABASE_PASSWORD=

# Secreto aleatorio de al menos 32 bytes; puede reutilizar el JWT_SECRET local de Compose.
JWT_SECRET=
JWT_EXPIRATION=24h

WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# Resend - https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=UPAM <no-reply@upam.edu.sv>

FRONTEND_URL=http://localhost:5173

PORT=3000
